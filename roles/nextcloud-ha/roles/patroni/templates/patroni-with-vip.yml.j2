---
scope: {{ patroni_scope }}
namespace: {{ patroni_namespace }}
name: {{ patroni_name }}

restapi:
  listen: 0.0.0.0:{{ patroni_api_port }}
  connect_address: {{ wg_ip }}:{{ patroni_api_port }}

etcd3:
  hosts:
{% for host in groups['nextcloud_cluster'] %}
    - {{ hostvars[host].wg_ip }}:{{ etcd_port_client }}
{% endfor %}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    synchronous_mode_strict: false
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 5
        max_replication_slots: 5
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - local all postgres peer
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all {{ wireguard_network }} scram-sha-256
    - host all all {{ nextcloud_docker_network_cidr }} scram-sha-256
    - host replication replicator {{ wireguard_network }} scram-sha-256
postgresql:
  listen: 0.0.0.0:{{ postgres_port }}
  connect_address: {{ wg_ip }}:{{ postgres_port }}
  data_dir: /var/lib/postgresql/{{ postgres_version }}/patroni
  pgpass: /var/lib/postgresql/.pgpass
  bin_dir: /usr/lib/postgresql/{{ postgres_version }}/bin
  authentication:
    replication:
      username: replicator
      password: {{ postgres_replication_password | to_json }}
    superuser:
      username: postgres
      password: {{ postgres_superuser_password | to_json }}
  pg_hba:
    - local all postgres peer
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all {{ wireguard_network }} scram-sha-256
    - host all {{ nextcloud_db_user }} {{ nextcloud_docker_network_cidr }} scram-sha-256
    - host all {{ onlyoffice_db_user }} {{ nextcloud_docker_network_cidr }} scram-sha-256
    - host replication replicator {{ wireguard_network }} scram-sha-256
  parameters:
    unix_socket_directories: /var/run/postgresql
    shared_buffers: 256MB
    work_mem: 16MB
    maintenance_work_mem: 128MB
    effective_cache_size: 1GB
    checkpoint_completion_target: 0.9
    wal_buffers: 16MB
    default_statistics_target: 100
    password_encryption: scram-sha-256

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false

log:
  level: INFO
