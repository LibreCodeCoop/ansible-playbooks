POSTGRES_DB={{ nextcloud_db_name }}
POSTGRES_USER={{ nextcloud_db_user }}
POSTGRES_PASSWORD={{ nextcloud_db_password }}
POSTGRES_HOST={{ nextcloud_postgres_host }}
REDIS_HOST={{ nextcloud_redis_host }}
REDIS_HOST_PORT={{ nextcloud_redis_port }}
REDIS_HOST_PASSWORD={{ redis_password }}

NEXTCLOUD_VERSION={{ nextcloud_image_version }}
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_trusted_domains }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user | default('admin') }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password | default('') }}
NEXTCLOUD_ADMIN_EMAIL={{ nextcloud_admin_email | default('admin@example.com') }}
TZ={{ nextcloud_timezone }}

GARAGES3_BUCKET={{ garage_s3_bucket }}
GARAGES3_KEY={{ garage_s3_key_id }}
GARAGES3_KEY_ID={{ garage_s3_key_id }}
GARAGES3_SECRET={{ garage_s3_secret }}
GARAGES3_HOSTNAME={{ garage_s3_endpoint_host }}
GARAGES3_PORT={{ garage_s3_api_port }}
GARAGES3_REGION={{ garage_s3_region }}
GARAGES3_USE_SSL={{ garage_s3_use_ssl | bool | ternary('1', '0') }}
GARAGES3_USE_PATH_STYLE=1
GARAGES3_AUTOCREATE=1
GARAGES3_VERIFY_BUCKET_EXISTS=1

VIRTUAL_HOST={{ nextcloud_domain }}
LETSENCRYPT_HOST={{ nextcloud_domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email | default('') }}
