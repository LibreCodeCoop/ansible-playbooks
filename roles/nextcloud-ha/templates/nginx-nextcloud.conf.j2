# Nextcloud Nginx Configuration
# Generated by Ansible

upstream php-handler {
    server unix:/run/php/php{{ php_version }}-fpm.sock;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ nextcloud_domain }};
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ nextcloud_domain }};
    
    # SSL Configuration (substituir por Let's Encrypt em produção)
    ssl_certificate /etc/ssl/certs/nextcloud.crt;
    ssl_certificate_key /etc/ssl/private/nextcloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    
    # Security headers
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Path to Nextcloud root
    root {{ nextcloud_install_path }};
    index index.php index.html /index.php$request_uri;
    
    # HSTS (após testar SSL)
    # add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    
    # Disable logging for static assets
    location ~* \.(?:css|js|woff2?|svg|gif|map)$ {
        try_files $uri /index.php$request_uri;
        access_log off;
        add_header Cache-Control "public, max-age=15768000, immutable";
    }
    
    # Nextcloud handlers
    location = /robots.txt { allow all; log_not_found off; access_log off; }
    location = /.well-known/carddav { return 301 $scheme://$host/remote.php/dav; }
    location = /.well-known/caldav { return 301 $scheme://$host/remote.php/dav; }
    location /.well-known/acme-challenge { allow all; }
    
    # Block access to config/data directories
    location ~ ^/(?:build|tests|config|lib|3rdparty|templates|data)/ { deny all; }
    location ~ ^/(?:\.|autotest|occ|issue|indie|db_|console) { deny all; }
    
    # PHP-FPM handler
    location ~ \.php(?:$|/) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        set $path_info $fastcgi_path_info;
        
        try_files $fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_pass php-handler;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param HTTPS on;
        
        # Security
        fastcgi_param modHeadersAvailable true;
        fastcgi_param front_controller_active true;
        fastcgi_intercept_errors on;
        fastcgi_request_buffering off;
        
        # Timeouts
        fastcgi_read_timeout 300;
        fastcgi_send_timeout 300;
    }
    
    # Main location
    location / {
        try_files $uri $uri/ /index.php$request_uri;
    }
    
    # Static assets
    location ~* \.(?:jpg|jpeg|gif|bmp|ico|png|webp|svg|woff|woff2|ttf|eot|otf|mp4|webm|ogg|ogv|js|css|map|json)$ {
        try_files $uri =404;
        access_log off;
        expires max;
    }
}