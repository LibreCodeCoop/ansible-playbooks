# WireGuard Configuration - {{ inventory_hostname }}
# Generated by Ansible

[Interface]
PrivateKey = {{ wg_private_key_value }}
Address = {{ wg_ip }}/24
ListenPort = {{ wireguard_port }}
MTU = {{ wireguard_mtu | default(1380) }}
SaveConfig = false

{% for host in groups['nextcloud_cluster'] %}
{% if host != inventory_hostname %}
# Peer: {{ host }} ({{ hostvars[host]['wg_ip'] }})
[Peer]
PublicKey = {{ hostvars[host].wg_public_key_value }}
Endpoint = {{ hostvars[host]['ansible_host'] }}:{{ wireguard_port }}
AllowedIPs = {{ hostvars[host].wg_ip }}/32
PersistentKeepalive = 25

{% endif %}
{% endfor %}
