metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = {{ garage_replication_factor }}

rpc_bind_addr = "0.0.0.0:{{ garage_rpc_port }}"
rpc_public_addr = "{{ wg_ip }}:{{ garage_rpc_port }}"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "{{ garage_s3_region }}"
api_bind_addr = "0.0.0.0:{{ garage_s3_api_port }}"
root_domain = "{{ garage_s3_root_domain }}"

[admin]
api_bind_addr = "0.0.0.0:{{ garage_admin_port }}"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_metrics_token }}"
